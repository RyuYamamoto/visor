<?xml version="1.0"?>
<!-- Entry file shaped like a real robot_description: arguments, a find-based include, an env-selected model include, one macro call. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="$(arg robot_name)">
  <xacro:arg name="robot_name" default="fixture" />
  <xacro:include filename="$(find robot_description)/urdf/materials.xacro" />
  <xacro:include filename="$(optenv ROBOT_MODEL demo)_model.xacro" />
  <xacro:robot use_mesh="$(optenv USE_MESH true)" />
</robot>
