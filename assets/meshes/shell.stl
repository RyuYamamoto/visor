solid visor_shell
  facet normal 0 0 1
    outer loop
      vertex -0.1 -0.1 0
      vertex 0.1 -0.1 0
      vertex 0.1 0.1 0
    endloop
  endfacet
  facet normal 0 0 1
    outer loop
      vertex -0.1 -0.1 0
      vertex 0.1 0.1 0
      vertex -0.1 0.1 0
    endloop
  endfacet
endsolid visor_shell
